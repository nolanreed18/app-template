{
  "appId": "__APP_ID__",
  "appName": "__APP_NAME__",
  "webDir": "www",
  "backgroundColor": "#0b0e14",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0e14",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0b0e14",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b0e14",
      "overlaysWebView": true
    }
  }
}
